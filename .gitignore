# Public showcase: deny everything by default, then allow specific files.
/*
!/.gitignore
!/README.md
!/assets/
/assets/*
!/assets/BloodOmen2-Native-iOS-Banner.png
!/assets/BloodOmen2-Concept-Banner.png
!/assets/BloodOmen2-AppIcon.png
!/assets/controller.svg
!/assets/3d.svg

# Development and game data are always local.
/source/
/build/
/logs/
/Backend/
/scripts/
/docs/
/output/
*.iso
*.chd
*.bios
*.ipa
*.partial
__pycache__/
.DS_Store
