# Public showcase: deny everything by default, then allow specific files.
/*
!/.gitignore
!/README.md
!/output/
/output/*
!/output/BloodOmen2-Native-iOS-Banner.png
!/output/BloodOmen2-Concept-Banner.png
!/output/BloodOmen2-AppIcon.png

# Development and game data are always local.
/source/
/build/
/logs/
/Backend/
/scripts/
/docs/
*.iso
*.chd
*.bios
*.ipa
*.partial
__pycache__/
.DS_Store
